/**
 * playChord2(int freq1, int freq2, int dur)
 * Génère une synthèse sonore polyphonique sur deux buzzers par modulation logicielle.
 * * * Caractéristiques techniques :
 * - Synthèse logicielle : Utilise micros() et digitalWrite() pour simuler un signal PWM sur deux fréquences distinctes simultanément[cite: 13].
 * - Gestion du temps : Calcule les périodes en microsecondes pour une précision optimale des fréquences[cite: 13].
 * - Réactivité critique : Scrute les ports Serial et BluetoothSerial à chaque cycle de la boucle while pour détecter la commande d'arrêt 'x'[cite: 9, 10].
 * * * Paramètres :
 * - freq1 : Fréquence de la première note en Hz (appliquée au buzzer1).
 * - freq2 : Fréquence de la deuxième note en Hz (appliquée au buzzer2).
 * - dur   : Durée de l'accord en millisecondes.
 * * * Effets de bord :
 * - Modifie l'état des pins buzzer1 et buzzer2[cite: 10, 13].
 * - Positionne le flag global stopMusic à true en cas d'interruption par l'utilisateur[cite: 10, 11].
 * - Réinitialise les sorties à LOW en fin d'exécution ou en cas d'arrêt forcé[cite: 10].
 */
void playChord2(int freq1, int freq2, int dur) {
  long startTime = millis();
  long period1 = 1000000L / freq1;
  long period2 = 1000000L / freq2;
  unsigned long lastTime1 = micros();
  long lastTime2 = micros();
  int state1 = LOW;
  int state2 = LOW;
  while (millis() - startTime < dur) {
    if (Serial.available()) {
      char c = Serial.read();
      if (c == 'x') {
        digitalWrite(buzzer1, LOW);
        digitalWrite(buzzer2, LOW);
        noTone(buzzer3);
        stopMusic = true;  
        return;
    }
    }
    if (BluetoothSerial.available()) {
      char c = BluetoothSerial.read();
      if (c == 'x') {
        digitalWrite(buzzer1, LOW);
        digitalWrite(buzzer2, LOW);
        noTone(buzzer3);
        stopMusic = true;
        return;
      }
    }
    long now = micros();
    if (now - lastTime1 >= period1 / 2) {
      state1 = !state1;
      digitalWrite(buzzer1, state1);
      lastTime1 = now;
    }
    if (now - lastTime2 >= period2 / 2) {
      state2 = !state2;
      digitalWrite(buzzer2, state2);
      lastTime2 = now;
    }
  }

  digitalWrite(buzzer1, LOW);
  digitalWrite(buzzer2, LOW);
}

/**
 * playMelodyS()
 * Joue le thème de Star Wars en utilisant une combinaison de polyphonie logicielle et de signaux matériels.
 * * * * Caractéristiques techniques :
 * - Structure hybride : Alterne entre playChord2() pour les harmonies complexes et tone() pour les notes simples ou montées dramatiques[cite: 9, 13].
 * - Sécurité d'arrêt : Utilise la macro CHECK_STOP pour interrompre la lecture et forcer l'état LOW sur tous les buzzers si stopMusic est vrai[cite: 10, 14].
 * - Rythme : Décomposition précise en trois phases (Introduction, Montée dramatique, Section centrale) avec des délais calibrés entre 50ms et 450ms.
 * * * * Matériel sollicité :
 * - Trio de buzzers : Mobilise les pins 7, 8 et 9 simultanément pour enrichir la texture sonore du thème[cite: 3].
 * - Nettoyage final : Assure l'extinction complète des buzzers 1 et 2 en fin de morceau pour éviter tout grésillement résiduel.
 * * * * Effets de bord :
 * - Modifie le flag global stopMusic en cas d'interruption par commande 'x'[cite: 9, 10].
 * - Réinitialise les sorties numériques des trois buzzers.
 */
void playMelodyS() {
  #define CHECK_STOP if (stopMusic) { stopMusic = false; digitalWrite(buzzer1, LOW); digitalWrite(buzzer2, LOW); digitalWrite(buzzer3, LOW); return; }
  playChord2(440, 220, 500); delay(50);
  playChord2(440, 220, 500); delay(50);
  playChord2(440, 220, 500); delay(50);
  playChord2(349, 175, 350); delay(50);
  tone(buzzer3, 523, 150); delay(200);
  playChord2(440, 220, 500); delay(50);
  playChord2(349, 175, 350); delay(50);
  tone(buzzer1, 523, 150); delay(200);
  playChord2(440, 220, 800); delay(100);

  // --- Montée dramatique ---
  playChord2(659, 330, 500); delay(50);
  playChord2(659, 330, 500); delay(50);
  playChord2(659, 330, 500); delay(50);
  playChord2(698, 349, 350); delay(50);
  tone(buzzer1, 523, 150); delay(200);
  playChord2(415, 208, 500); delay(50);
  playChord2(349, 175, 350); delay(50);
  tone(buzzer1, 523, 150); delay(200);
  playChord2(440, 220, 800); delay(100);

  // --- Section centrale (ex buzzer3 → buzzer2) ---
  tone(buzzer1, 880, 200); tone(buzzer2, 220, 200); delay(300);
  playChord2(440, 220, 350); delay(50);
  playChord2(440, 220, 150); delay(50);
  tone(buzzer1, 880, 200); tone(buzzer2, 220, 200); delay(300);
  playChord2(830, 415, 350); delay(50);
  playChord2(784, 392, 150); delay(50);

  // --- Descente finale ---
  tone(buzzer1, 740, 150); delay(100);
  tone(buzzer2, 698, 150); delay(450);  // arpège simplifié
  playChord2(523, 262, 500); delay(50);
  playChord2(440, 220, 350); delay(50);
  playChord2(349, 175, 150); delay(50);
  playChord2(523, 262, 500); delay(50);
  playChord2(440, 220, 350); delay(50);
  playChord2(349, 175, 150); delay(50);
  playChord2(440, 220, 1000); delay(200);
  digitalWrite(buzzer1, LOW);
  digitalWrite(buzzer2, LOW);
  #undef CHECK_STOP
}

