#include <SoftwareSerial.h>
#include <DHT.h>
#define DHTPIN 2
#define DHTTYPE DHT11
DHT dht(DHTPIN, DHTTYPE);

SoftwareSerial BluetoothSerial(10, 11);
const int redPin = 5;
const int greenPin = 3;
const int bluePin = 4;
const int buzzer1 = 7;   
const int buzzer2 = 8;  
const int buzzer3 = 9;   
const int lightSensor = A1;
const int soundSensor = A0;
const int thresholdL = 180; 
const int thresholdS = 50;  
bool manualMode = false;
bool stopMusic = false;
float lastTemp = 0;
float lastHum = 0;
unsigned long lastDHTRead = 0;

/*
 * readLight()
 * Retourne la luminosité moyenne sur 10 lectures analogiques (pin A1).
 * Un délai de 200µs entre chaque lecture stabilise le convertisseur ADC
 * et évite les valeurs parasites dues aux rebonds électriques.
 * Plage retournée : 0 (obscurité totale) → 1023 (pleine lumière).
 */
int readLight() {
  int sum = 0;
  for (int i = 0; i < 10; i++) {
    sum += analogRead(lightSensor);
    delayMicroseconds(200); 
  }
  return sum / 10;
}

/*
 * readSound()
 * Retourne l'amplitude sonore mesurée sur une fenêtre de 50ms (pin A0).
 * Algorithme : capture le maximum et le minimum des lectures ADC sur 50ms,
 * puis retourne leur écart (max - min).
 * Avantage par rapport à un simple analogRead() :
 *   - Capture les pics transitoires (clap, voix) même très courts
 *   - Indépendant de la tension de repos du capteur KY-037 (~512)
 * Plage retournée : ~0-20 (silence) → 200-600+ (bruit fort).
 */
int readSound() {
  int peakMax = 0;
  int peakMin = 1023;
  long startTime = millis();

  while (millis() - startTime < 50) {  
    int val = analogRead(soundSensor);
    if (val > peakMax) peakMax = val;
    if (val < peakMin) peakMin = val;
  }
  return peakMax - peakMin;
}

/*
 * setup()
 * Initialisation unique au démarrage de l'Arduino.
 * - Configure les broches OUTPUT : LED RGB (pins 3,4,5), buzzers (pins 7,8,9)
 * - Configure les broches INPUT  : capteurs lumière (A1), son (A0)
 * - Démarre le capteur DHT11 (pin 2)
 * - Ouvre les ports série : USB à 9600 bauds, Bluetooth HC-05 à 9600 bauds
 * - Éteint la LED RGB (état initial propre)
 * - Envoie "Systeme pret" sur USB pour confirmer le démarrage à l'interface web
 */
void setup() {
  pinMode(redPin, OUTPUT);
  pinMode(greenPin, OUTPUT);
  pinMode(bluePin, OUTPUT);
  pinMode(lightSensor, INPUT);
  pinMode(soundSensor, INPUT);
  pinMode(buzzer1, OUTPUT);
  pinMode(buzzer2, OUTPUT);
  pinMode(buzzer3, OUTPUT);
  dht.begin();
  Serial.begin(9600);
  BluetoothSerial.begin(9600);
  setColor(0, 0, 0); // Éteint au démarrage
  Serial.println("Systeme pret - USB + Bluetooth actifs!");
}

/*
 * loop()
 * Boucle principale exécutée en continu (~80-100ms par cycle).
 *
 * Ordre d'exécution :
 *   1. Lecture capteurs :
 *        - Luminosité  : moyenne 10 lectures sur ~2ms   (readLight)
 *        - Son         : amplitude sur fenêtre 50ms     (readSound)
 *        - Température et humidité : toutes les 2000ms  (DHT11 trop lent pour plus)
 *          Si la lecture DHT échoue (isnan), conserve la dernière valeur valide.
 *
 *   2. Envoi des données série :
 *        - USB       : "L:xxx S:yyy T:tt.t H:hh.h"  (interface web)
 *        - Bluetooth : "L:xxx" + "S:yyy"             (T et H omis, trop verbeux)
 *
 *   3. Réception des commandes :
 *        - USB et Bluetooth lus séparément
 *        - Transmis à handleCommand() avec flag origine (true=USB, false=BT)
 *
 *   4. Mode automatique (si manualMode == false) :
 *        - lightValue >= thresholdL (200) → LED verte  (JOUR)
 *        - lightValue <  thresholdL       → LED rouge  (NUIT)
 *        - soundLevel >  thresholdS (100) → Flash jaune 150ms + bip buzzer
 *
 *   5. delay(30) : complète le cycle à ~100ms
 *      (readSound prend déjà 50ms + readLight ~2ms)
 */
void loop() {
  int lightValue = readLight();          
  int soundLevel = readSound();
  if (millis() - lastDHTRead >= 2000) {
    float t = dht.readTemperature();
    float h = dht.readHumidity();
    if (!isnan(t)) lastTemp = t;  
    if (!isnan(h)) lastHum  = h;
    lastDHTRead = millis();
  }

  Serial.print("L:"); Serial.print(lightValue);
  Serial.print(" S:"); Serial.print(soundLevel);
  Serial.print(" T:"); Serial.print(lastTemp, 1);
  Serial.print(" H:"); Serial.println(lastHum, 1);

  BluetoothSerial.print("L:"); BluetoothSerial.println(lightValue);
  BluetoothSerial.print("S:"); BluetoothSerial.println(soundLevel);
  if (Serial.available()) {
    char c = Serial.read();
    Serial.print("USB reçu: "); Serial.println(c);
    handleCommand(c, true);
  }
  if (BluetoothSerial.available()) {
    char c = BluetoothSerial.read();
    Serial.print("BT reçu: "); Serial.println(c);
    handleCommand(c, false);
  }
  if (manualMode == false) {

    // Couleur de base selon luminosité
    if (lightValue >= thresholdL) {
      setColor(0, 255, 0);   // JOUR : vert
    } else {
      setColor(255, 0, 0);   // NUIT : rouge
    }

    if (soundLevel > thresholdS) {
      setColor(255, 255, 0);   // Flash jaune pendant le bip
      delay(150);
    }
  }

  delay(30);
}

/*
 * handleCommand(char c, bool isUSB)
 * Point d'entrée centralisé pour toutes les commandes reçues (USB et Bluetooth).
 * Exécute l'action correspondante et envoie une confirmation sur le bon port
 * via sendResponse().
 *
 * Paramètres :
 *   c     — caractère de commande reçu
 *   isUSB — true = répondre sur Serial (USB), false = répondre sur BluetoothSerial
 *
 * Tableau des commandes :
 *   '1' / 'r' → LED Rouge   (manualMode = true)
 *   '2' / 'g' → LED Verte   (manualMode = true)
 *   '3' / 'b' → LED Bleue   (manualMode = true)
 *   '4' / 'y' → LED Jaune   (manualMode = true)
 *   '5' / 'w' → LED Blanche (manualMode = true)
 *   '!'       → Sirène d'alarme (3 buzzers, 5 cycles)
 *   'p'       → Mélodie Joyeux Anniversaire (2 buzzers)
 *   's'       → Mélodie Star Wars (3 buzzers)
 *   'f'       → Mélodie Frère Jacques (2 buzzers)
 *   't'       → Mode test (alternance buzzer + LED)
 *   'x'       → Arrêt immédiat de toutes les mélodies (stopMusic = true)
 *   '0'/'o'/'a' → Extinction LED + retour mode automatique (manualMode = false)
 *
 * Variables globales modifiées :
 *   manualMode — passé à true pour toute commande couleur, false pour 'a'/'o'/'0'
 *   stopMusic  — passé à true pour forcer l'arrêt dans playChord2/playChord3
 */
void handleCommand(char c, bool isUSB) {
  if (c == '1' || c == 'r') {
    setColor(255, 0, 0);
    sendResponse("Rouge", isUSB);
    manualMode = true;
  }
  else if (c == '2' || c == 'g') {
    setColor(0, 255, 0);
    sendResponse("Vert", isUSB);
    manualMode = true;
  }
  else if (c == '3' || c == 'b') {
    setColor(0, 0, 255);
    sendResponse("Bleu", isUSB);
    manualMode = true;
  }
  else if (c == '4' || c == 'y') {
    setColor(255, 255, 0);
    sendResponse("Jaune", isUSB);
    manualMode = true;
  }
  else if (c == '5' || c == 'w') {
    setColor(255, 255, 255);
    sendResponse("Blanc", isUSB);
    manualMode = true;
  }
  else if (c == '!') {
    sendResponse("Sirene", isUSB);
    siren();
  }
  else if (c == 'p') {
    sendResponse("Melodie P", isUSB);
    playMelodyP();
  }
  else if (c == 's') {
    sendResponse("Melodie S", isUSB);
    playMelodyS();
  }
  else if (c == 'f') {
    sendResponse("Melodie F", isUSB);
    playMelodyF();
  }
  else if (c == 't') {
    sendResponse("Test", isUSB);
    test();
  }
  else if (c == 'x') {
    stopMusic = true;        
    noTone(buzzer1);
    noTone(buzzer2);
    noTone(buzzer3);
    digitalWrite(buzzer1, LOW);  
    digitalWrite(buzzer2, LOW);
    sendResponse("Stop", isUSB);
  }
  else if (c == '0' || c == 'o' || c == 'a') {
    setColor(0, 0, 0);
    manualMode = false;
    sendResponse("Mode Auto", isUSB);
  }
}

/**
 * sendResponse(String message, bool isUSB)
 * Envoie un message de confirmation ou d'état vers le port de communication approprié.
 * * Paramètres :
 * - message : La chaîne de caractères à transmettre (ex: "Rouge", "Mode Auto").
 * - isUSB  : Flag booléen déterminant le canal de sortie (true=USB, false=BT).
 */
void sendResponse(String message, bool isUSB) {
  if (isUSB) {
    Serial.println(message);
  } else {
    BluetoothSerial.println(message);
  }
}


/**
 * setColor(int r, int g, int b)
 * Définit la couleur de la LED RGB en modifiant l'intensité de chaque composante.
 * * Paramètres :
 * - r : Intensité du rouge (0 à 255).
 * - g : Intensité du vert (0 à 255).
 * - b : Intensité du bleu (0 à 255).
 * * Notes matérielles :
 * - Utilise analogWrite pour générer un signal PWM permettant le mélange des couleurs[cite: 13].
 */
void setColor(int r, int g, int b) {
  analogWrite(redPin, r);
  analogWrite(greenPin, g);
  analogWrite(bluePin, b);
}

/**
 * siren()
 * Génère une mélodie d'alarme cyclique en utilisant les trois buzzers en alternance. [cite: 9]
 * * Caractéristiques techniques :
 * - Utilise 3 buzzers polyphoniques sur les pins 7, 8 et 9. [cite: 3]
 * - Fréquences : Oscillations entre sons aigus et graves pour l'effet d'alerte.
 * - Réactivité : Temps de réponse à l'arrêt ~100ms (durée d'un delay). [cite: 9]
 * * Effets de bord :
 * - Modifie l'état des pins buzzer1, buzzer2 et buzzer3.
 * - Réinitialise stopMusic à false en cas d'interruption. [cite: 14]
 */
void siren() {
  #define CHECK_STOP if (stopMusic) { stopMusic = false; noTone(buzzer1); noTone(buzzer2); noTone(buzzer3); return; }
  for (int i = 0; i < 5; i++) {
    tone(buzzer1, 900, 150); delay(100); CHECK_STOP;
    tone(buzzer3, 950, 150); delay(100); CHECK_STOP;
    tone(buzzer2, 850, 150); delay(100); CHECK_STOP;

    tone(buzzer1, 500, 150); delay(100); CHECK_STOP;
    tone(buzzer3, 550, 150); delay(100); CHECK_STOP;
    tone(buzzer2, 450, 150); delay(100); CHECK_STOP;
  }

  noTone(buzzer1);
  noTone(buzzer2);
  noTone(buzzer3);

  #undef CHECK_STOP
}

/**
 * test()
 * Exécute une routine de diagnostic matériel pour vérifier les LEDs et les buzzers.
 * * Caractéristiques techniques :
 * - Durée totale : Environ 6 secondes (600ms par cycle x 10)[cite: 9].
 * - Matériel sollicité : Pins 8 (buzzer2), 9 (buzzer3) et pins RGB (3, 4, 5)[cite: 3].
 * * Note importante :
 * - Contrairement aux autres mélodies, cette fonction ne contient pas de 
 * vérification CHECK_STOP et s'exécutera jusqu'à la fin de la boucle[cite: 9].
 */
void test() {
  for (int i = 0; i < 10; i++) {
    tone(buzzer3, 950, 250);
    setColor(0, 255, 0);
    delay(300);
    noTone(buzzer3);

    tone(buzzer2, 950, 250);
    setColor(0, 0, 255);
    delay(300);
    noTone(buzzer2);
  }
}

